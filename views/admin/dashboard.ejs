<%- include('../partials/admin-header', { title: 'Dashboard', activePage: 'dashboard', adminName: adminName }) %>

<section class="space-y-6" id="page-dashboard">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div class="bg-white rounded-2xl border border-[#DEE2E6] p-6 shadow-sm flex items-center justify-between hover:shadow-md transition">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-[#F8F9FA] border border-[#DEE2E6] flex items-center justify-center text-[#212529]">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </div>
        <div>
          <p class="text-xs text-[#6C757D] font-semibold uppercase tracking-wider">Total Chats</p>
          <h3 class="text-3xl font-extrabold text-[#212529] mt-0.5"><%= totalChats %></h3>
        </div>
      </div>
      <span class="text-xs font-semibold text-emerald-600 bg-[#D4EDDA] px-2 py-1 rounded-lg">Live</span>
    </div>

    <div class="bg-white rounded-2xl border border-[#DEE2E6] p-6 shadow-sm flex items-center justify-between hover:shadow-md transition">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-[#F8F9FA] border border-[#DEE2E6] flex items-center justify-center text-[#212529]">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </div>
        <div>
          <p class="text-xs text-[#6C757D] font-semibold uppercase tracking-wider">Total Keywords</p>
          <h3 class="text-3xl font-extrabold text-[#212529] mt-0.5"><%= totalKeywords %></h3>
        </div>
      </div>
      <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded-lg">Active</span>
    </div>

    <div class="bg-white rounded-2xl border border-[#DEE2E6] p-6 shadow-sm flex items-center justify-between hover:shadow-md transition">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-[#F8F9FA] border border-[#DEE2E6] flex items-center justify-center text-[#212529]">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </div>
        <div>
          <p class="text-xs text-[#6C757D] font-semibold uppercase tracking-wider">Unanswered Questions</p>
          <h3 class="text-3xl font-extrabold text-[#212529] mt-0.5"><%= unanswered %></h3>
        </div>
      </div>
      <span class="text-xs font-semibold text-rose-600 bg-[#F8D7DA] px-2 py-1 rounded-lg">Attention</span>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-[#DEE2E6] shadow-sm overflow-hidden">
    <div class="p-5 border-b border-[#DEE2E6] flex justify-between items-center">
      <h2 class="font-bold text-lg text-[#212529]">Recent Activity</h2>
      <a class="text-xs font-semibold text-[#212529] hover:underline" href="/admin/history">View All</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-[#212529]">
        <thead class="bg-[#F8F9FA] border-b border-[#DEE2E6] text-xs font-bold text-[#6C757D]">
          <tr>
            <th class="py-3 px-5" scope="col">Session</th>
            <th class="py-3 px-5" scope="col">User Message</th>
            <th class="py-3 px-5" scope="col">Bot Response</th>
            <th class="py-3 px-5 text-right" scope="col">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#DEE2E6]/60 text-xs sm:text-sm">
          <% if (recentActivity.length === 0) { %>
            <tr>
              <td class="py-10 px-5 text-center text-[#6C757D]" colspan="4">
                Belum ada aktivitas chat. Data akan muncul di sini setelah pengguna memulai percakapan.
              </td>
            </tr>
          <% } %>
          <% recentActivity.forEach(function (row) {
               // Use the stored status flag, not the reply text. The bot stores
               // the fallback message when nothing matches, so testing for an
               // empty reply marks every miss as answered, and matching the
               // wording breaks as soon as the admin edits fallback_message.
               const unanswered = row.status === 'Unanswered'
                 || (!row.status && (row.pesan_keluar === null || row.pesan_keluar === '')); %>
            <tr class="hover:bg-[#F8F9FA]/70 transition">
              <td class="py-3.5 px-5 font-mono text-[11px] text-[#343A40]"><%= row.token || '-' %></td>
              <td class="py-3.5 px-5 text-[#212529]"><%= row.pesan_masuk || '-' %></td>
              <td class="py-3.5 px-5 text-[#6C757D]"><%= row.pesan_keluar || '-' %></td>
              <td class="py-3.5 px-5 text-right">
                <% if (unanswered) { %>
                  <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                      Unanswered
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                      Answered
                  </span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../partials/admin-footer') %>
