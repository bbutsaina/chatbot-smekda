<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Login &mdash; Chatbot Admin Portal</title>

  <!-- Tailwind CSS v3 with Plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              dark: '#212529',
              gray: '#343A40',
              muted: '#6C757D',
              border: '#DEE2E6',
              light: '#F8F9FA',
              card: '#FFFFFF',
              emeraldBg: '#D4EDDA',
              emeraldText: '#155724',
              redBg: '#F8D7DA',
              redText: '#721C24'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="antialiased">
  <main class="min-h-screen bg-[#F8F9FA] flex items-center justify-center p-4 md:p-8 antialiased font-[Arial,Helvetica,sans-serif]">
    <section class="max-w-[850px] w-full min-h-[480px] bg-white border border-[#DEE2E6] shadow-xl rounded-[24px] overflow-hidden flex flex-col md:flex-row">
      <div class="relative min-h-[260px] md:min-h-0 md:w-[45%] overflow-hidden bg-neutral-200 md:[clip-path:polygon(0_0,100%_0,82%_100%,0_100%)]" aria-label="Image placeholder"></div>

      <div class="md:w-[55%] p-8 md:p-12 flex flex-col items-center justify-center text-center">
        <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-[12px] text-sm text-center mb-4 w-full max-w-[360px] mx-auto">
                <%= error %>
            </div>
        <% } %>

        <div class="mb-8 text-center">
          <h1 class="text-[28px] leading-tight font-bold text-[#212529]">Hi, Admin!</h1>
          <p class="mt-1 text-sm text-[#6C757D]">Login to continue</p>
        </div>

        <form action="/admin/login" method="POST" class="mx-auto flex w-full max-w-[360px] flex-col gap-4">
          <div class="border border-[#DEE2E6] bg-white rounded-[12px] px-4 py-3.5 flex items-center gap-3 relative shadow-xs">
            <svg aria-hidden="true" class="size-4 shrink-0 text-[#343A40]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <input type="email" name="email" value="<%= typeof email !== 'undefined' && email ? email : '' %>" placeholder="Email" aria-label="Email" class="w-full text-left text-sm text-[#212529] placeholder:text-[#ADB5BD] focus:outline-none focus:ring-0 focus:border-[#DEE2E6] bg-transparent" required />
          </div>

          <div class="border border-[#DEE2E6] bg-white rounded-[12px] px-4 py-3.5 flex items-center gap-3 relative shadow-xs">
            <svg aria-hidden="true" class="size-4 shrink-0 text-[#343A40]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="5" y="10" width="14" height="10" rx="2"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2"></path>
            </svg>
            <input type="password" name="password" placeholder="Password" aria-label="Password" class="w-full text-left text-sm text-[#212529] placeholder:text-[#ADB5BD] focus:outline-none focus:ring-0 focus:border-[#DEE2E6] bg-transparent" required />
          </div>

          <div class="-mt-2 flex justify-end">
            <a href="mailto:butsaina2134@gmail.com?subject=Reset Password Admin IRIS-2" class="text-xs font-semibold text-[#343A40] underline underline-offset-2 decoration-[#DEE2E6] hover:text-[#212529] hover:decoration-[#212529] transition">Lupa Password?</a>
          </div>

          <button type="submit" class="bg-[#212529] text-white font-bold py-3.5 rounded-full text-center block w-full transition-all duration-150 hover:bg-[#343A40] active:scale-[0.99] shadow-md">Login</button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
