<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
  <title>Admin Login &mdash; Chatbot Admin Portal</title>

  <!-- desain foto & form login -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              dark: '#212529',
              gray: '#343A40',
              muted: '#6C757D',
              border: '#DEE2E6',
              light: '#F8F9FA',
              card: '#FFFFFF',
              emeraldBg: '#D4EDDA',
              emeraldText: '#155724',
              redBg: '#F8D7DA',
              redText: '#721C24'
            }
          }
        }
      }
    }
  </script>
  <style data-purpose="login-bg">
    /* latar titik */
    .login-bg {
      background-color: #F8F9FA;
      background-image: radial-gradient(circle, #DEE2E6 1px, transparent 1px);
      background-size: 22px 22px;
    }
    /* cahaya lembut */
    .login-glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 70% 60% at 60% 50%, rgba(33,37,41,0.045) 0%, transparent 70%);
      pointer-events: none;
    }
    /* fokus input */
    .login-input:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(33,37,41,0.12);
      border-color: #343A40;
    }
  </style>
</head>
<body class="antialiased">
  <main class="login-bg min-h-screen flex items-center justify-center p-4 md:p-8 antialiased font-[Arial,Helvetica,sans-serif] relative overflow-hidden">
    <div class="login-glow"></div>
    <section class="relative max-w-[860px] w-full min-h-[490px] bg-white border border-zinc-200/80 shadow-[0_8px_40px_-8px_rgba(33,37,41,0.13),0_2px_8px_-2px_rgba(33,37,41,0.07)] rounded-[26px] overflow-hidden flex flex-col md:flex-row">
      <div class="relative min-h-[260px] md:min-h-0 md:w-[45%] overflow-hidden bg-[#E9ECEF] md:[clip-path:polygon(0_0,100%_0,82%_100%,0_100%)]" aria-label="Image placeholder">
        <img src="/images/login-bg.jpg" alt="SMKN 2 Purwakarta" class="w-full h-full object-cover grayscale contrast-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-900/60 via-zinc-900/15 to-transparent pointer-events-none"></div>
      </div>

      <div class="md:w-[55%] px-8 py-10 md:px-12 md:py-14 flex flex-col items-center justify-center text-center">
        <% if (locals.error) { %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-[12px] text-sm text-center mb-5 w-full max-w-[360px] mx-auto shadow-xs font-medium">
                <%= locals.error %>
            </div>
        <% } %>

        <div class="mb-8 text-center">
          <div class="w-11 h-11 rounded-2xl bg-[#212529] flex items-center justify-center mx-auto mb-4 shadow-sm">
            <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
            </svg>
          </div>
          <h1 class="text-[28px] leading-tight font-bold text-[#212529]">Hi, Admin!</h1>
          <p class="mt-1 text-sm text-[#6C757D]">Login to continue</p>
        </div>

        <form action="/admin/login" method="POST" class="mx-auto flex w-full max-w-[360px] flex-col gap-3.5">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : (locals.csrfToken || '') %>" />
          <div class="border border-[#DEE2E6] bg-white rounded-[12px] px-4 py-3.5 flex items-center gap-3 relative shadow-xs hover:border-[#ADB5BD] transition-colors duration-150">
            <svg aria-hidden="true" class="size-4 shrink-0 text-[#343A40]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <input type="email" name="email" value="<%= typeof email !== 'undefined' && email ? email : '' %>" placeholder="Email" aria-label="Email" class="login-input w-full text-left text-sm text-[#212529] placeholder:text-[#ADB5BD] focus:outline-none focus:ring-0 bg-transparent" required />
          </div>

          <div class="border border-[#DEE2E6] bg-white rounded-[12px] px-4 py-3.5 flex items-center gap-3 relative shadow-xs hover:border-[#ADB5BD] transition-colors duration-150">
            <svg aria-hidden="true" class="size-4 shrink-0 text-[#343A40]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="5" y="10" width="14" height="10" rx="2"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2"></path>
            </svg>
            <input type="password" name="password" placeholder="Password" aria-label="Password" class="login-input w-full text-left text-sm text-[#212529] placeholder:text-[#ADB5BD] focus:outline-none focus:ring-0 bg-transparent" required />
          </div>

          <div class="-mt-1 flex justify-end">
            <a href="mailto:butsaina2134@gmail.com?subject=Reset Password Admin IRIS-2" class="text-xs font-semibold text-[#343A40] underline underline-offset-2 decoration-[#DEE2E6] hover:text-[#212529] hover:decoration-[#212529] transition">Lupa Password?</a>
          </div>

          <button type="submit" class="mt-1 bg-[#212529] text-white font-bold py-3.5 rounded-full text-center block w-full transition-all duration-200 hover:bg-[#343A40] hover:shadow-md active:scale-[0.985] shadow-sm">Login</button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
