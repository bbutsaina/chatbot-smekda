<!DOCTYPE html><html lang="id" style=""><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>IRIS-2 - SMEKDA Assistant</title>
<!-- Tailwind CSS CDN with forms plugin -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- BEGIN: Custom Styles -->
<style data-purpose="custom-scrollbars">
    /* Custom thin scrollbar for chat viewport */
    #chat-messages::-webkit-scrollbar {
      width: 5px;
    }
    #chat-messages::-webkit-scrollbar-track {
      background: transparent;
    }
    #chat-messages::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    #chat-messages::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
<style data-purpose="chat-animations">
    @keyframes typingDot {
      0%, 80%, 100% { transform: scale(0); opacity: 0.4; }
      40% { transform: scale(1); opacity: 1; }
    }
    .typing-dot {
      animation: typingDot 1.4s infinite ease-in-out both;
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    .typing-dot:nth-child(3) { animation-delay: 0s; }
  </style>
<!-- END: Custom Styles -->
</head>
<body class="bg-[#FAFAFA] text-[#212529] min-h-screen flex items-center justify-center p-4 sm:p-6 md:p-10 font-sans antialiased selection:bg-slate-200">
<!-- BEGIN: MainContainer -->
<main class="w-full max-w-6xl mx-auto flex flex-col lg:flex-row items-center lg:items-start justify-center gap-8 lg:gap-14 py-4">
<!-- BEGIN: LeftColumnInfo -->
<section class="w-full lg:w-5/12 flex flex-col justify-center space-y-7 pt-4 lg:pt-10">
<!-- School Branding Header -->
<div class="flex items-center gap-3.5">
<!-- School Crest: official logo image -->
<div class="w-12 h-12 flex-shrink-0 rounded-xl flex items-center justify-center bg-white shadow-sm border border-slate-200 p-1">
<img src="/images/smekda.png" alt="Logo SMK Negeri 2 Purwakarta" class="w-10 h-10 object-contain" />
</div>
<div>
<h2 class="text-sm font-semibold tracking-wide text-slate-800 leading-tight">SMK Negeri 2</h2>
<h3 class="text-xl font-bold tracking-tight text-slate-900 leading-tight">Purwakarta</h3>
</div>
</div>
<!-- Main Catchphrase & Description -->
<div class="space-y-3">
<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#1e2329]">
          Hi, aku IRIS-2
        </h1>
<p class="text-slate-600 text-base leading-relaxed">
          IRIS-2 merupakan singkatan dari <span class="font-semibold text-slate-800">Interactive Response &amp; Information System</span> untuk SMKN 2 Purwakarta.
        </p>
</div>
<!-- Developer Info Card -->
<div class="border border-slate-200/90 bg-white shadow-sm rounded-2xl p-6 sm:p-7 relative transition-all">
<p class="text-[13.5px] leading-relaxed text-slate-600 font-normal">
          IRIS-2 dikembangkan oleh <span class="font-semibold text-slate-800">Butsaina Dzurwa M.</span>, seorang full-stack developer siswa kelas 12 Rekayasa Perangkat Lunak (RPL) dengan tujuan untuk memodernisasi kualitas pelayanan informasi digital di SMKN 2 Purwakarta. Hubungi instagram <a class="font-medium text-slate-900 hover:text-blue-600 underline decoration-slate-300 hover:decoration-blue-500 transition-colors" href="https://instagram.com/bbutsaina" rel="noopener" target="_blank">@bbutsaina</a> jika menemukan bug sistem atau informasi data yang kurang akurat, terima kasih.
        </p>
</div>
</section>
<!-- END: LeftColumnInfo -->
<!-- BEGIN: RightColumnChatWidget -->
<section class="w-full lg:w-6/12 max-w-[480px]">
<!-- Chat Widget Wrapper -->
<div class="w-full bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200 flex flex-col overflow-hidden h-[640px]">
<!-- BEGIN: ChatHeader -->
<header class="bg-[#343A40] px-5 py-4 flex items-center gap-3.5 flex-shrink-0 text-white shadow-sm">
<!-- Bot Avatar Emblem -->
<div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center border border-white/20">
<svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
<path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"></path>
</svg>
</div>
<!-- Header Labels & Status Indicator -->
<div class="flex-1 min-w-0">
<div class="flex items-center gap-2">
<h4 class="font-bold text-sm tracking-wide text-white truncate">IRIS - SMEKDA Assistant</h4>
</div>
<div class="flex items-center gap-1.5 mt-0.5">
<span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
<span class="text-xs text-slate-300 font-normal">Here to Help You!</span>
</div>
</div>
<!-- Refresh / reset conversation -->
<button type="button" aria-label="Refresh conversation" title="Refresh conversation"
  onclick="window.location.reload()"
  class="p-2 text-white/80 hover:text-white bg-transparent outline-none focus:outline-none focus:ring-0 transition-colors border-none flex-shrink-0">
  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
    <polyline points="21 3 21 9 15 9"></polyline>
  </svg>
</button>
</header>
<!-- END: ChatHeader -->
<!-- BEGIN: ChatFeedArea -->
<div class="flex-1 bg-[#F8F9FA] p-5 overflow-y-auto space-y-4" id="chat-messages">
<!-- Initial Greeting Bot Bubble -->
<div class="flex flex-col items-start space-y-1.5 max-w-[85%]">
<div class="bg-[#E9ECEF] text-[#212529] px-4 py-3 rounded-2xl rounded-tl-sm text-sm border border-slate-200/70 shadow-sm leading-relaxed">
              <%= greeting %>
            </div>
<span class="text-[11px] text-[#6C757D] font-medium pl-1" data-purpose="greeting-time"></span>
</div>
<!-- Quick Access FAQ Pills Container -->
<div class="pt-2" id="faq-section">
<p class="text-xs font-semibold text-[#6C757D] mb-2.5 pl-0.5">Frequently Asked</p>
<div class="flex flex-col space-y-2">
<button class="w-full text-left bg-[#E9ECEF] hover:bg-[#DEE2E6] text-slate-800 text-xs sm:text-[13px] font-medium px-4 py-3 rounded-xl border border-slate-300/40 hover:border-slate-300 transition duration-150 active:scale-[0.99] flex items-center justify-between group" onclick="handleQuickSelect('Apa Web official SMK Negeri 2 Purwakarta?')">
<span class="">Apa Web official SMK Negeri 2 Purwakarta?</span>
<svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
<button class="w-full text-left bg-[#E9ECEF] hover:bg-[#DEE2E6] text-slate-800 text-xs sm:text-[13px] font-medium px-4 py-3 rounded-xl border border-slate-300/40 hover:border-slate-300 transition duration-150 active:scale-[0.99] flex items-center justify-between group" onclick="handleQuickSelect('Bagaimana cara daftar?')">
<span class="">Bagaimana cara daftar?</span>
<svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
<button class="w-full text-left bg-[#E9ECEF] hover:bg-[#DEE2E6] text-slate-800 text-xs sm:text-[13px] font-medium px-4 py-3 rounded-xl border border-slate-300/40 hover:border-slate-300 transition duration-150 active:scale-[0.99] flex items-center justify-between group" onclick="handleQuickSelect('Berapa kuota jurusan RPL?')">
<span class="">Berapa kuota jurusan RPL?</span>
<svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
<button class="w-full text-left bg-[#E9ECEF] hover:bg-[#DEE2E6] text-slate-800 text-xs sm:text-[13px] font-medium px-4 py-3 rounded-xl border border-slate-300/40 hover:border-slate-300 transition duration-150 active:scale-[0.99] flex items-center justify-between group" onclick="handleQuickSelect('Dimana alamat SMEKDA?')">
<span class="">Dimana alamat SMEKDA?</span>
<svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
</div>
</div>
</div>
<!-- END: ChatFeedArea -->
<!-- BEGIN: ChatInputForm -->
<footer class="p-3.5 bg-[#F8F9FA] border-t border-slate-200">
<form class="flex items-center gap-2" id="chat-form">
<!-- Text Input Field -->
<input autocomplete="off" class="flex-1 bg-white border border-slate-300 focus:border-slate-500 focus:ring-1 focus:ring-slate-500 text-slate-800 text-sm rounded-full px-4 py-2.5 outline-none placeholder:text-slate-400 transition" id="user-input" name="query" placeholder="Message" type="text">
<!-- Submit Button -->
<button aria-label="Send message" class="w-10 h-10 rounded-full bg-[#343A40] hover:bg-[#212529] text-white flex items-center justify-center transition active:scale-95 flex-shrink-0 shadow-sm disabled:opacity-50" id="send-btn" type="submit">
<svg class="w-4 h-4 transform rotate-45 -mr-0.5 -mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path></svg>
</button>
</form>
</footer>
<!-- END: ChatInputForm -->
</div>
</section>
<!-- END: RightColumnChatWidget -->
</main>
<!-- END: MainContainer -->
<!-- BEGIN: ChatLogicScript -->
<script data-purpose="chat-interactive-handlers">
    const chatMessages = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const userInput = document.getElementById('user-input');
    const faqSection = document.getElementById('faq-section');
    const sendBtn = document.getElementById('send-btn');

    function getCurrentTime() {
      const now = new Date();
      return now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
    }

    function scrollToBottom() {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    /**
     * Build a chat bubble with DOM nodes.
     *
     * Message text is assigned via textContent rather than interpolated into an
     * innerHTML template. Interpolating would let a student inject markup into
     * their own transcript and execute script in the page.
     */
    function addMessage(sender, text) {
      const isUser = sender === 'user';
      const timeStr = getCurrentTime();

      const bubbleWrapper = document.createElement('div');
      bubbleWrapper.className = `flex flex-col ${isUser ? 'items-end ml-auto' : 'items-start'} max-w-[85%] space-y-1`;

      const bubble = document.createElement('div');
      bubble.className = isUser
        ? 'bg-[#343A40] text-white px-4 py-2.5 rounded-2xl rounded-tr-sm text-sm shadow-sm leading-relaxed'
        : 'bg-[#E9ECEF] text-[#212529] px-4 py-3 rounded-2xl rounded-tl-sm text-sm border border-slate-200/70 shadow-sm leading-relaxed';
      bubble.textContent = text;

      const stamp = document.createElement('span');
      stamp.className = `text-[11px] text-[#6C757D] font-medium ${isUser ? 'pr-1' : 'pl-1'}`;
      stamp.textContent = timeStr;

      bubbleWrapper.appendChild(bubble);
      bubbleWrapper.appendChild(stamp);
      chatMessages.appendChild(bubbleWrapper);
      scrollToBottom();
    }

    function showTypingIndicator() {
      removeTypingIndicator();
      const typingEl = document.createElement('div');
      typingEl.id = 'typing-indicator';
      typingEl.className = 'flex flex-col items-start max-w-[85%] space-y-1';

      const bubble = document.createElement('div');
      bubble.className = 'bg-[#E9ECEF] text-slate-500 px-4 py-3 rounded-2xl rounded-tl-sm border border-slate-200/70 shadow-sm flex items-center gap-1.5';
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.className = 'w-1.5 h-1.5 bg-slate-500 rounded-full typing-dot';
        bubble.appendChild(dot);
      }

      typingEl.appendChild(bubble);
      chatMessages.appendChild(typingEl);
      scrollToBottom();
    }

    function removeTypingIndicator() {
      const typingEl = document.getElementById('typing-indicator');
      if (typingEl) typingEl.remove();
    }

    function setBusy(on) {
      sendBtn.disabled = on;
      userInput.disabled = on;
    }

    /**
     * Send the student message to the Node controller, which matches it against
     * FAQ keywords in MySQL, logs the exchange, and returns the reply.
     */
    async function processUserMessage(message) {
      const cleanMessage = message.trim();
      if (!cleanMessage) return;

      addMessage('user', cleanMessage);

      // Hide the FAQ pills after the first interaction to keep the timeline clean.
      if (faqSection) faqSection.style.display = 'none';

      showTypingIndicator();
      setBusy(true);

      try {
        const res = await fetch('/api/chatbot/query', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: cleanMessage })
        });
        const data = await res.json();
        removeTypingIndicator();
        addMessage('bot', data.reply);
      } catch (err) {
        removeTypingIndicator();
        addMessage('bot', 'Sorry.... I don\u2019t really catch that :[');
      } finally {
        setBusy(false);
        userInput.focus();
      }
    }

    function handleQuickSelect(questionText) {
      processUserMessage(questionText);
    }

    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = userInput.value;
      if (text.trim()) {
        processUserMessage(text);
        userInput.value = '';
      }
    });

    // Stamp the server-rendered greeting bubble with the current time.
    const greetingTime = document.querySelector('[data-purpose="greeting-time"]');
    if (greetingTime) greetingTime.textContent = getCurrentTime();
  </script>
<!-- END: ChatLogicScript -->


</body></html>